# Two hosts, two variable sets. Never mix them on one Railway service.
# Neither host is AFOS (do not set these on app.apexformlife.com).
# No Apex Hub IDs belong in git — paste them only into .env or Railway Variables.

# =============================================================================
# OPERATOR — existing Noticing Lens service (“my version” / Apex Hub)
# =============================================================================
# Set these. Leave RESURFACE_FIXTURE unset (commented) on this host.
# https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx

# Database IDs = 32 hex characters in each database URL (before ?v=).
# Apex Hub: Tasks Inbox, Projects, optional Goals.
NOTION_TASKS_DB_ID=
NOTION_PROJECTS_DB_ID=
# Optional: Goals database for Intelligence and weekly inbox audit
# NOTION_GOALS_DB_ID=
# NOTION_NOTES_DB_ID=

# Optional: Notion view / data-source IDs (the ?v= value is a view ID)
# NOTION_PROJECTS_VIEW_ID=
# NOTION_TASKS_ACTIVE_VIEW_ID=
# NOTION_TASKS_COMPLETE_VIEW_ID=
# NOTION_NOTES_VIEW_ID=
# NOTION_GOALS_VIEW_ID=
# NOTION_TASKS_DATA_SOURCE_ID=

# Optional: interpretation fill on the operator only
# OPENAI_API_KEY=

# Optional: this operator host’s public origin (OG tags)
# PUBLIC_APP_URL=https://your-operator.up.railway.app

# Optional: print JSON after the weekly inbox-audit job (operator only)
# INBOX_AUDIT_JSON=1

# Port (PaaS hosts set this; do not override on Railway)
# PORT=5000

# =============================================================================
# DEMO — new Railway service noticing-lens-demo
# =============================================================================
# On that service, set ONLY the next line. Unset every NOTION_* and OPENAI_API_KEY.
# Do not put this on the operator service.
# RESURFACE_FIXTURE=overflow
# PUBLIC_APP_URL=https://lens.apexformlife.com
# Custom domain: CNAME lens.apexformlife.com → this demo service.

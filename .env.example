# Notion Integration Token — required for live workspace data
# https://www.notion.so/my-integrations
NOTION_API_KEY=ntn_xxxxxxxxxxxxxxxxxxxx

# Database IDs from each database URL (32 hex chars). Required for live Notion.
# Do not commit real IDs to a public fork if they are not yours to share.
NOTION_NOTES_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_PROJECTS_DB_ID=

# Optional: Goals database for Intelligence and weekly inbox audit
# NOTION_GOALS_DB_ID=

# Optional: Notion view / data-source IDs for CLI/view-based paths
# NOTION_PROJECTS_VIEW_ID=
# NOTION_TASKS_ACTIVE_VIEW_ID=
# NOTION_TASKS_COMPLETE_VIEW_ID=
# NOTION_NOTES_VIEW_ID=
# NOTION_GOALS_VIEW_ID=
# NOTION_TASKS_DATA_SOURCE_ID=

# Optional: interpretation fill when RESURFACE_FIXTURE is unset
# OPENAI_API_KEY=

# Port (PaaS hosts set this)
# PORT=5000

# Fixture the OS without Notion or OpenAI (overflow | healthy).
# Public Think demo: overflow only. Leave Notion and OpenAI unset.
# Do not set this on app.apexformlife.com (that host is AFOS).
# RESURFACE_FIXTURE=overflow

# Optional: public origin of this host (OG tags). Lockup still goes to apexformlife.com.
# PUBLIC_APP_URL=https://your-demo.up.railway.app

# Optional: print JSON after the weekly inbox-audit job
# INBOX_AUDIT_JSON=1
